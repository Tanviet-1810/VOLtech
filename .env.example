# Environment variables for Docker Compose
# Copy this file to .env and fill in your values

# Backend
JWT_SECRET=your_jwt_secret_key_min_32_characters_please_change_this_to_random_string
NODE_ENV=production

# Frontend
VITE_CHAT_BOT_API_KEY=your_gemini_api_key_here

# MongoDB (optional, defaults are fine for development)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=password
